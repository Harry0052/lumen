# Local SQLite file. Not a secret. Tests can override this with a temporary path.
LUMEN_DB_PATH=data/lumen.db

# Optional. Unlocks the editor desk. When unset, Lumen uses the documented
# local code "local-desk" and says so on the editor screen. Set a unique
# value before sharing a server. Do not commit a real secret.
# LUMEN_EDITOR_CODE=

# No language-model key is read. Lumen does not call an LLM provider.
# LUMEN_LLM_API_KEY is intentionally unused.
